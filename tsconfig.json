{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts", "apps/worker/**/*.ts"],
  "exclude": ["**/dist", "**/tsup.config.ts"]
}
