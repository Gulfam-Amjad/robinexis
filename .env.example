# ── Robinexis production platform (EXAMPLE — placeholders only) ──
# cp .env.example .env   ← real keys go in .env (gitignored, never committed).

# ── Vercel (public, prefixed VITE_) ──
# Set VITE_API_BASE_URL after Railway generates the API public domain.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://cdbcbzvhzdiwwcrmxjgi.supabase.co
VITE_SUPABASE_ANON_KEY=
# Local/Playwright. On Vercel this skips the login screen (rebuild required).
# Pair with SKIP_AUTH + ALLOW_INSECURE_SKIP_AUTH on Railway api for testing only.
VITE_SKIP_AUTH=true

# ── Railway (set per service) ──
# api | gateway | worker | web
RAILWAY_BUILD_TARGET=api

# ── Railway API ──
WEB_ORIGIN=https://robinexis-pink.vercel.app
ADMIN_EMAILS=gulfamamjad633@gmail.com
SUPABASE_URL=https://cdbcbzvhzdiwwcrmxjgi.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_KEY_ID=
API_PORT=8081
API_PUBLIC_BASE_URL=

# ── Shared data plane ──
# Railway: paste DATABASE_URL from local .env (gitignored). Use the Supabase
# session pooler (port 5432, host *.pooler.supabase.com) — the direct db.*
# host is IPv6-only and Railway hobby/trial cannot reach it (ENETUNREACH).
# Example shape only; keep the real password in local/cloud secrets:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Supavisor presents a self-signed chain Node does not trust out of the box.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
REDIS_URL=redis://localhost:6379
REQUIRE_DATABASE=false

# ElevenLabs — /demo-build, and TTS in apps/voice-gateway
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=L4so9SudEsIYzE9j4qlR
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_CHUNK_SCHEDULE=50,90,120,150

# Twilio — Groq gateway uses TWILIO_SANDBOX_PHONE_NUMBER or TWILIO_PHONE_NUMBER as From.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SANDBOX_PHONE_NUMBER=+15555550199
TWILIO_SMS_NUMBER=+15555550199

# Cal.com — per-tenant in the database when possible; these are local fallbacks only
CALCOM_API_KEY=
CALCOM_USERNAME=

# Groq — Whisper STT and the conversational Llama brain
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

STT_PROVIDER=groq
VAD_ENERGY_THRESHOLD=500
VAD_SILENCE_MS=500

# Gemini — tenant-scoped knowledge embeddings / RAG
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55

# apps/voice-gateway
FRONT_DESK_PHONE_NUMBER=+15555550199
FALLBACK_VOICEMAIL_URL=
PUBLIC_BASE_URL=
PORT=8080

# Stripe — billing service only. The conversational brain never receives these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GRACE_DAYS=3
STRIPE_PRICE_FEATURES_JSON=

STRUCTURED_LOG_FILE=
WORKER_POLL_MS=15000
DATA_RETENTION_DAYS=90

# Local API. On Railway also set ALLOW_INSECURE_SKIP_AUTH=true (testing only).
SKIP_AUTH=true
ALLOW_INSECURE_SKIP_AUTH=false
ADMIN_API_KEY=

# Make.com — legacy 24h reminder recipe (optional; worker replaces this)
MAKE_API_KEY=
MAKE_ZONE=
MAKE_TEAM_ID=
