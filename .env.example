# ── Robinexis production platform (EXAMPLE — placeholders only) ──
# cp .env.example .env   ← real keys go in .env (gitignored, never committed).

# ── Vercel (public, prefixed VITE_) ──
VITE_API_BASE_URL=http://localhost:8081
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Local/Playwright only. Ignored by production API.
VITE_SKIP_AUTH=true

# ── Railway (set per service) ──
# api | gateway | worker | web
RAILWAY_BUILD_TARGET=api

# ── Railway API ──
WEB_ORIGIN=http://localhost:5173
ADMIN_EMAILS=gulfamamjad633@gmail.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
API_PORT=8081
API_PUBLIC_BASE_URL=https://api.example.ngrok.io

# ── Shared data plane ──
# Railway: paste DATABASE_URL from local .env / .env.railway (gitignored). Use the
# Supabase session/direct URI on port 5432, not the transaction pooler.
# Example shape (replace password; never commit the real URI):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cdbcbzvhzdiwwcrmxjgi.supabase.co:5432/postgres
DATABASE_SSL=true
REDIS_URL=redis://localhost:6379
REQUIRE_DATABASE=false

# ElevenLabs — /demo-build, and TTS in apps/voice-gateway
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=L4so9SudEsIYzE9j4qlR
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_CHUNK_SCHEDULE=50,90,120,150

# Twilio — Groq gateway uses TWILIO_SANDBOX_PHONE_NUMBER or TWILIO_PHONE_NUMBER as From.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SANDBOX_PHONE_NUMBER=
TWILIO_SMS_NUMBER=

# Cal.com — per-tenant in the database when possible; these are local fallbacks only
CALCOM_API_KEY=
CALCOM_USERNAME=

# Groq — Whisper STT and the conversational Llama brain
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

STT_PROVIDER=groq
VAD_ENERGY_THRESHOLD=500
VAD_SILENCE_MS=500

# Gemini — tenant-scoped knowledge embeddings / RAG
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55

# apps/voice-gateway
FRONT_DESK_PHONE_NUMBER=
FALLBACK_VOICEMAIL_URL=
PUBLIC_BASE_URL=https://example.ngrok.io
PORT=8080

# Stripe — billing service only. The conversational brain never receives these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GRACE_DAYS=3
STRIPE_PRICE_FEATURES_JSON=

STRUCTURED_LOG_FILE=
WORKER_POLL_MS=15000
DATA_RETENTION_DAYS=90

# Local API only. Ignored on Railway / NODE_ENV=production.
SKIP_AUTH=true
ADMIN_API_KEY=

# Make.com — legacy 24h reminder recipe (optional; worker replaces this)
MAKE_API_KEY=
MAKE_ZONE=
MAKE_TEAM_ID=
