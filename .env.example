# ── Robinexis production platform (EXAMPLE — placeholders only) ──
# cp .env.example .env   ← real keys go in .env (gitignored, never committed).

# ── Vercel (public, prefixed VITE_) ──
# Set VITE_API_BASE_URL after Railway generates the API public domain.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://cdbcbzvhzdiwwcrmxjgi.supabase.co
VITE_SUPABASE_ANON_KEY=
# Supabase Auth Site URL: https://app.robinexis.com
# Allowed redirects:
#   https://app.robinexis.com/auth/callback
#   https://robinexis-pink.vercel.app/auth/callback
#   http://localhost:5173/auth/callback
# These live in the Supabase dashboard (Authentication → URL Configuration), not in this file.
# When a callback is missing from that allowlist Supabase silently discards it and drops the
# user on the Site URL instead, which strands them signed-out on another origin. Confirm the
# dashboard matches the lines above before trusting them:
#   curl -sS -o /dev/null -D - "$SUPABASE_URL/auth/v1/verify?token=invalid&type=magiclink\
#     &redirect_to=https%3A%2F%2Fapp.robinexis.com%2Fauth%2Fcallback"
# The Location header must echo back app.robinexis.com/auth/callback, not the Site URL.
# Local testing only. Never set true on Vercel.
VITE_SKIP_AUTH=false

# ── Railway (set per service) ──
# api | worker
RAILWAY_BUILD_TARGET=api

# ── Railway API ──
WEB_ORIGIN=https://app.robinexis.com,https://robinexis-pink.vercel.app
# Comma-separated verified Supabase identities. Keep real addresses private.
ADMIN_EMAILS=
SUPABASE_URL=https://cdbcbzvhzdiwwcrmxjgi.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_KEY_ID=
API_PORT=8081
API_PUBLIC_BASE_URL=

# ── Shared data plane ──
# Railway: paste DATABASE_URL from local .env (gitignored). Use the Supabase
# session pooler (port 5432, host *.pooler.supabase.com) — the direct db.*
# host is IPv6-only and Railway hobby/trial cannot reach it (ENETUNREACH).
# Example shape only; keep the real password in local/cloud secrets:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Supavisor presents a self-signed chain Node does not trust out of the box.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
REQUIRE_DATABASE=false

# ElevenLabs management scripts only. Live call audio goes directly Twilio → ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# Twilio status webhook and provider administration. Railway never receives call audio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_NUMBER=+15555550199

# Cal.com — per-tenant in the database when possible; these are local fallbacks only
CALCOM_API_KEY=
CALCOM_USERNAME=

# Voice-tool authentication. The legacy secret remains bound to Blades.
# For additional tenants use JSON shaped as {"client_id":"a-long-unique-secret"}.
VOICE_TOOL_SECRET=
VOICE_TOOL_SECRETS_JSON={}

# Gemini — tenant-scoped knowledge embeddings / RAG
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55

# Stripe — billing service only. The conversational brain never receives these.
# Use test-mode keys only until go-live. Do not create Products/Prices in app code.
# Dashboard (test): https://dashboard.stripe.com/test/products
#   1. Product "Starter" → recurring price £99 GBP / month → copy price_…
#   2. Product "Pro" → recurring price £249 GBP / month → copy price_…
#   3. Paste both into STRIPE_PRICE_IDS_JSON on Railway, then register
#      POST {API_PUBLIC_BASE_URL}/webhooks/stripe in the Stripe test webhook settings.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GRACE_DAYS=3
STRIPE_PRICE_FEATURES_JSON=
# Railway API + worker must both have STRIPE_SECRET_KEY. Worker reconcile is a no-op without it.
STRIPE_PRICE_IDS_JSON={"starter":"price_test_starter","pro":"price_test_pro"}

# Included call minutes are operational defaults and can be changed without code.
PLAN_STARTER_INCLUDED_MINUTES=300
PLAN_PRO_INCLUDED_MINUTES=1500
PLAN_ENTERPRISE_INCLUDED_MINUTES=5000
# Keep false while outbound calling remains retired.
OUTBOUND_AUTOMATION_ENABLED=false
# Explicit release gate for external ElevenLabs/Twilio side effects.
SAAS_PROVISIONING_ENABLED=false

STRUCTURED_LOG_FILE=
WORKER_POLL_MS=15000
DATA_RETENTION_DAYS=90

# Local API only. Production should always use Supabase JWTs.
SKIP_AUTH=false
ALLOW_INSECURE_SKIP_AUTH=false
ADMIN_API_KEY=
