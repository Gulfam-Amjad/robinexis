# ── Robinexis production platform (EXAMPLE — placeholders only) ──
# cp .env.example .env   ← real keys go in .env (gitignored, never committed).

# ── Vercel (public, prefixed VITE_) ──
# Set VITE_API_BASE_URL after Railway generates the API public domain.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://cdbcbzvhzdiwwcrmxjgi.supabase.co
VITE_SUPABASE_ANON_KEY=
# Supabase Auth Site URL: https://app.robinexis.com
# Allowed redirects:
#   https://app.robinexis.com/auth/callback
#   https://robinexis-pink.vercel.app/auth/callback
#   http://localhost:5173/auth/callback
# These live in the Supabase dashboard (Authentication → URL Configuration), not in this file.
# When a callback is missing from that allowlist Supabase silently discards it and drops the
# user on the Site URL instead, which strands them signed-out on another origin. Confirm the
# dashboard matches the lines above before trusting them:
#   curl -sS -o /dev/null -D - "$SUPABASE_URL/auth/v1/verify?token=invalid&type=magiclink\
#     &redirect_to=https%3A%2F%2Fapp.robinexis.com%2Fauth%2Fcallback"
# The Location header must echo back app.robinexis.com/auth/callback, not the Site URL.
# Magic links and sign-up confirmations need custom SMTP (Authentication → Emails → SMTP
# Settings), currently Google Workspace on hello@robinexis.com. Supabase's built-in mailer
# only delivers to members of the Supabase org and caps the whole project at 2 emails/hour,
# so without it every other address silently receives nothing. The app password lives in
# Google and the Supabase dashboard only, never here.
# Local testing only. Never set true on Vercel.
VITE_SKIP_AUTH=false

# ── Railway (set per service) ──
# api | worker
RAILWAY_BUILD_TARGET=api

# ── Railway API ──
WEB_ORIGIN=https://app.robinexis.com,https://robinexis-pink.vercel.app
# Comma-separated verified Supabase identities. Keep real addresses private.
ADMIN_EMAILS=
SUPABASE_URL=https://cdbcbzvhzdiwwcrmxjgi.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_KEY_ID=
API_PORT=8081
API_PUBLIC_BASE_URL=

# ── Shared data plane ──
# Railway: paste DATABASE_URL from local .env (gitignored). Use the Supabase
# session pooler (port 5432, host *.pooler.supabase.com) — the direct db.*
# host is IPv6-only and Railway hobby/trial cannot reach it (ENETUNREACH).
# Example shape only; keep the real password in local/cloud secrets:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Supavisor presents a self-signed chain Node does not trust out of the box.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
REQUIRE_DATABASE=false

# Redis is mandatory in production so rate limits remain shared across deploys/replicas.
# Use the Railway Redis private REDIS_URL; never paste it into Vercel or source control.
REDIS_URL=
RATE_LIMIT_REDIS_REQUIRED=false

# ElevenLabs management scripts only. Live call audio goes directly Twilio → ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TWILIO_VOICE_URL=
# Estimated provider cost only; set from the current commercial agreement.
# Blank/invalid records usage with zero cost and rateConfigured=false.
ELEVENLABS_ESTIMATED_COST_PER_MINUTE_PENCE=
# Flash TTS for new non-Blades agents. Blades provisioning keeps the live model.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Default ConvAI voice for new workspaces (Jo, UK salon).
ELEVENLABS_VOICE_ID=L4so9SudEsIYzE9j4qlR

# Twilio status webhook and provider administration. Railway never receives call audio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_NUMBER=+15555550199
# Twilio customer-account OAuth. Redirect URI must end /oauth/twilio/callback.
TWILIO_OAUTH_CLIENT_ID=
TWILIO_OAUTH_CLIENT_SECRET=
TWILIO_OAUTH_REDIRECT_URI=
TWILIO_OAUTH_STATE_SECRET=
TWILIO_OAUTH_ENCRYPTION_KEY=
# Managed number purchase is an independent, explicit gate. Keep false until
# owner/operator confirmation, regulatory data and plan spend caps are ready.
TWILIO_MANAGED_PROVISIONING_ENABLED=false
# HTTPS voice callback supplied by the approved Twilio/ElevenLabs routing setup.
TWILIO_MANAGED_VOICE_URL=
# Additional immutable provider IDs to protect, comma-separated. Blades tenant
# and +447446868067 are always protected in code.
TWILIO_PROTECTED_RESOURCE_IDS=
WORKER_API_SECRET=

# Cal.com — per-tenant in the database when possible; these are local fallbacks only.
CALCOM_API_KEY=
CALCOM_USERNAME=
# Existing-account OAuth application ("Continue with Cal.com").
# Token exchange/refresh: POST https://api.cal.com/v2/auth/oauth2/token.
CALCOM_OAUTH_CLIENT_ID=
CALCOM_OAUTH_CLIENT_SECRET=
CALCOM_OAUTH_REDIRECT_URI=
CALCOM_OAUTH_STATE_SECRET=
# Cal.com publishes no token-revocation endpoint. Disconnect is local unless an
# operator sets a revocation URL here; leave blank to skip provider revocation.
CALCOM_OAUTH_REVOKE_URL=
# 32 random bytes encoded as base64url (or a long random secret).
CALCOM_CREDENTIAL_ENCRYPTION_KEY=
# Managed-user Cal.com Platform application.
CALCOM_PLATFORM_CLIENT_ID=
CALCOM_PLATFORM_CLIENT_SECRET=
CALCOM_PLATFORM_ORG_ID=

# Website ingestion. Keep bounded crawling disabled until the onboarding implementation lands.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Lifecycle email. Production uses Resend; "log" is local/test only.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
EMAIL_DELIVERY_MODE=log

# Voice-tool authentication. The legacy secret remains bound to Blades.
# For additional tenants use JSON shaped as {"client_id":"a-long-unique-secret"}.
VOICE_TOOL_SECRET=
VOICE_TOOL_SECRETS_JSON={}

# ── Alternate LiveKit voice runtime (worker service on free Railway; OFF by default) ──
# Do not enable until a sandbox dispatch and rollback review are approved.
VOICE_RUNTIME_ENABLED=false
# New Starter workspaces use LiveKit only when this is true AND VOICE_RUNTIME_ENABLED=true.
# Keep false in production until a non-Blades sandbox has passed booking tests.
CHEAP_VOICE_DEFAULT_ENABLED=false
# Both gates must be explicitly enabled before an operator switch can perform
# any provider or Twilio routing write.
PROVIDER_SWITCH_ENABLED=false
PROVIDER_SWITCH_ROUTING_ENABLED=false
# Enables offline benchmark evaluation/storage only; it does not permit routing.
PROVIDER_QUALITY_EVALUATION_ENABLED=false
# A LiveKit switch fails closed when its passed stored gate is older than this.
PROVIDER_LAUNCH_GATE_MAX_AGE_HOURS=168
VOICE_RUNTIME_API_BASE_URL=
VOICE_RUNTIME_INTERNAL_SECRET=
VOICE_RUNTIME_SIGNING_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_DEPLOYMENT_ID=
LIVEKIT_PHONE_NUMBER_ID=
# A LiveKit deployment must persist its exact Twilio VoiceUrl (and, when used,
# external SIP URI) in provider_deployments.config. SIP-only routing is rejected.
LIVEKIT_TWILIO_VOICE_URL=
LIVEKIT_SIP_URI=
LIVEKIT_SUSPEND_VOICE_URL=
DEEPGRAM_API_KEY=
# Cheap runtime defaults to Groq. Set "google" only as an explicit fallback.
VOICE_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
# Cheap runtime always speaks with ElevenLabs Flash.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional estimated provider rates in pence. Keep blank rather than guessing.
LIVEKIT_COST_PER_MINUTE_PENCE=
DEEPGRAM_COST_PER_MINUTE_PENCE=
GROQ_INPUT_COST_PER_MILLION_TOKENS_PENCE=
GROQ_OUTPUT_COST_PER_MILLION_TOKENS_PENCE=
GEMINI_INPUT_COST_PER_MILLION_TOKENS_PENCE=
GEMINI_OUTPUT_COST_PER_MILLION_TOKENS_PENCE=
ELEVENLABS_TTS_COST_PER_MILLION_CHARACTERS_PENCE=

# Gemini — tenant-scoped knowledge embeddings / RAG
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55

# Stripe — billing service only. The conversational brain never receives these.
# Use test-mode keys only until go-live. Do not create Products/Prices in app code.
# Dashboard (test): https://dashboard.stripe.com/test/products
#   1. Product "Starter" → recurring price £99 GBP / month → copy price_…
#   2. Product "Pro" → recurring price £249 GBP / month → copy price_…
#   3. Paste both into STRIPE_PRICE_IDS_JSON on Railway, then register
#      POST {API_PUBLIC_BASE_URL}/webhooks/stripe in the Stripe test webhook settings.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GRACE_DAYS=3
STRIPE_PRICE_FEATURES_JSON=
# Railway API + worker must both have STRIPE_SECRET_KEY. Worker reconcile is a no-op without it.
STRIPE_PRICE_IDS_JSON={"starter":"price_1UCwAlGz4wSF9YYToMv5zuPI","pro":"price_1UCwAnGz4wSF9YYT2MQXzcjN"}

# Included call minutes are operational defaults and can be changed without code.
PLAN_STARTER_INCLUDED_MINUTES=300
PLAN_PRO_INCLUDED_MINUTES=1500
PLAN_ENTERPRISE_INCLUDED_MINUTES=5000
PLAN_STARTER_TWILIO_SPEND_CAP_PENCE=0
PLAN_PRO_TWILIO_SPEND_CAP_PENCE=0
PLAN_ENTERPRISE_TWILIO_SPEND_CAP_PENCE=0
# Keep false while outbound calling remains retired.
OUTBOUND_AUTOMATION_ENABLED=false
# Explicit release gate for external ElevenLabs/Twilio side effects.
SAAS_PROVISIONING_ENABLED=false

STRUCTURED_LOG_FILE=
WORKER_POLL_MS=15000
WORKER_HEALTH_STALE_MS=120000
DATA_RETENTION_DAYS=90

# Error monitoring. DSNs and auth tokens are cloud/local secrets, never repository values.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Encrypted offsite backup inputs used by `npm run backup:postgres`.
# BACKUP_OUTPUT_PATH must be absolute, outside this repository, and end in .dump.age.
BACKUP_ENVIRONMENT=staging
BACKUP_OUTPUT_PATH=
BACKUP_AGE_RECIPIENT=
# Required when BACKUP_ENVIRONMENT=production.
BACKUP_CONFIRM_PRODUCTION=

# Local API only. Production should always use Supabase JWTs.
SKIP_AUTH=false
ALLOW_INSECURE_SKIP_AUTH=false
ADMIN_API_KEY=
